# Copy to .env and export (or set in your shell). NOTHING here is required to run the app.
# --- Case 3 digest delivery (optional; without these digests are saved as HTML and marked "dry run") ---
# Gmail: enable 2-step verification, create an "App password", use it as SMTP_PASSWORD. Free.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-password-here
SMTP_FROM=you@gmail.com
# Slack: create a free "Incoming Webhook" app and paste its URL (or set per-FC webhooks in data/fc_managers.json)
SLACK_WEBHOOK_URL=
# --- Optional free-tier LLM phrasing of insights (never touches numbers). Leave empty to stay fully offline ---
GEMINI_API_KEY=
# --- Tuning ---
# PROZO_WORKERS=2          background job threads
# PROZO_PARCEL_THREADS=2   parallel OCR threads inside one parcel job (use more on multi-core machines)
# PROZO_MAX_UPLOAD_MB=60
# --- Optional daily P&L inbox watcher (disabled unless a directory is set) ---
# PROZO_PNL_INBOX_DIR=C:\prozo\incoming\pnl
# PROZO_PNL_INBOX_INTERVAL=10
# PROZO_PNL_DEFAULT_FC=FC-1
